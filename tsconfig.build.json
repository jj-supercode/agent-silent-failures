{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "include": ["src/entries", "src/ingestion", "src/text", "src/trace"],
    "exclude": ["src/**/*.test.ts", "src/trace/testing.ts", "src/entries/*/fault*.ts"]
}

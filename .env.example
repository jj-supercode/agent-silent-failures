# Read only by the live commands (demo:live, demonstration:live, studio:live), and only this key.
ANTHROPIC_API_KEY=

# Other settings are shell environment variables, not .env entries (a value here would be ignored), e.g.
#   AGENT_SILENT_FAILURES_OUTPUT=json pnpm bed     # human | plain | json; flags win over it
#   STUDIO_LIVE_MAX_USD=2 pnpm studio:live         # spend cap for a Studio live session
#   NO_COLOR=1 or FORCE_COLOR=1                    # colour, per the usual conventions
